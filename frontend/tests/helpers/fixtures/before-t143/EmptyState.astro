---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  title: string;
  description?: string;
  icon?: IconName;
  headingLevel?: 2 | 3 | 4;
}
const { title, description, icon, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<div class="empty">
  {icon && <Icon name={icon} size={32} />}
  <Heading class="title">{title}</Heading>
  {description && <p class="description">{description}</p>}
  {
    Astro.slots.has('action') && (
      <div class="action">
        <slot name="action" />
      </div>
    )
  }
</div>

<style>
  @layer components {
    .empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-12);
      padding: var(--space-48) var(--space-16);
      text-align: center;
      color: var(--text-primary);
    }
    .title {
      margin: 0;
      font-family: var(--font-heading);
      font-size: var(--text-h3);
      font-weight: var(--weight-semibold);
      line-height: var(--leading-h3);
    }
    .description {
      margin: 0;
      max-width: 40ch;
      font-family: var(--font-ui);
      font-size: var(--text-body-ui);
      line-height: var(--leading-body-ui);
      color: var(--text-secondary);
    }
    .action {
      margin-block-start: var(--space-8);
    }
  }
</style>
