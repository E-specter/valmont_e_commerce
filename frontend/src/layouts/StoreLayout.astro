---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  headerVariant?: 'full' | 'compact';
}
const { title, description, noindex, headerVariant = 'full' } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <slot name="head" slot="head" />
  <div class="store" data-header-variant={headerVariant}>
    <SiteHeader variant={headerVariant} currentPath={Astro.url.pathname} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  @layer components {
    .store {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: var(--bg-page);
    }
    main {
      flex: 1;
      width: 100%;
      max-width: var(--container-max);
      margin-inline: auto;
      padding-inline: var(--page-margin);
    }
  }
</style>
