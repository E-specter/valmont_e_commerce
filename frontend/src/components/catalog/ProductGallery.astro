---
import type { ProductImage } from '../../lib/api/catalog';

interface Props {
  images: ProductImage[];
  productName: string;
}
const { images, productName } = Astro.props;
const [main] = images;
---

<div class="gallery" data-gallery>
  <div class="main">
    <img
      data-gallery-main
      src={main.url}
      alt={main.alt || productName}
      width="712"
      height="593"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  {
    images.length > 1 && (
      <ul class="thumbs" aria-label={`Imágenes de ${productName}`}>
        {images.map((img, i) => (
          <li>
            <a href={img.url} data-gallery-thumb data-alt={img.alt || productName} aria-current={i === 0 ? 'true' : undefined}>
              <img src={img.url} alt={img.alt || `${productName}, vista ${i + 1}`} width="160" height="160" decoding="async" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  // Sin JavaScript las miniaturas son enlaces a la imagen; con JavaScript cambian la principal.
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const main = root.querySelector<HTMLImageElement>('[data-gallery-main]');
    const thumbs = root.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]');
    thumbs.forEach((thumb) =>
      thumb.addEventListener('click', (event) => {
        if (!main) return;
        event.preventDefault();
        main.src = thumb.href;
        main.alt = thumb.dataset.alt ?? '';
        thumbs.forEach((t) => (t === thumb ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      }),
    );
  }
</script>

<style>
  @layer components {
    .gallery {
      display: flex;
      flex-direction: column;
      gap: var(--space-16);
      min-width: 0;
    }
    .main {
      aspect-ratio: 712 / 593;
      overflow: hidden;
      border: 1px solid var(--stroke-strong);
      border-radius: var(--radius-md);
      background: var(--bg-surface);
    }
    .main img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .thumbs {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-12);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .thumbs a {
      display: block;
      aspect-ratio: 1;
      overflow: hidden;
      border: 1px solid var(--stroke-strong);
      border-radius: var(--radius-md);
    }
    /* El activo se marca con grosor y amarillo, y con aria-current para el lector de pantalla */
    .thumbs a[aria-current] {
      border: 3px solid var(--color-yellow);
      outline: 1px solid var(--color-ink);
      outline-offset: -1px;
    }
    .thumbs img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
