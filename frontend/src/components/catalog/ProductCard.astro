---
import Availability from '../ui/Availability.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import Price from '../ui/Price.astro';
import type { ProductSummary } from '../../lib/api/catalog';
import { specLine } from './spec-line';

interface Props {
  product: ProductSummary;
  variant?: 'store' | 'related' | 'wishlist' | 'compact';
  headingLevel?: 2 | 3 | 4;
  priority?: boolean;
}
const { product, variant = 'store', headingLevel = 3, priority = false } = Astro.props;

// Relación de aspecto única por variante (BRIEF §12.5, PROPUESTA); width/height reservan el espacio (CLS).
const IMAGE = {
  store: { width: 320, height: 400 },
  wishlist: { width: 320, height: 400 },
  related: { width: 400, height: 400 },
  compact: { width: 100, height: 100 },
}[variant];
const Heading = `h${headingLevel}` as 'h3';
const spec = specLine(product);
const img = product.main_image;
const hasAction = Astro.slots.has('action');
---

<Card as="article" class="product-card" data-variant={variant} padding={variant === 'compact' ? 'sm' : 'md'}>
  <div class="media" style={`aspect-ratio: ${IMAGE.width} / ${IMAGE.height}`}>
    {
      img?.url ? (
        <img
          src={img.url}
          alt={img.alt}
          width={IMAGE.width}
          height={IMAGE.height}
          decoding="async"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
        />
      ) : (
        <span class="no-image" role="img" aria-label={`Sin imagen de ${product.name}`} />
      )
    }
    {
      hasAction && (
        <div class="action">
          <slot name="action" />
        </div>
      )
    }
  </div>
  <div class="body">
    <Heading class="name">
      <a href={`/relojes/${encodeURIComponent(product.slug)}`}>{product.name}</a>
    </Heading>
    {variant !== 'compact' && <p class="category">Colección {product.category.name}</p>}
    {spec && <p class="spec">{spec}</p>}
    <div class="foot">
      <Price
        price={product.price}
        originalPrice={product.original_price}
        discountAmount={product.discount_amount}
        size={variant === 'compact' ? 'sm' : 'md'}
      />
      {variant !== 'compact' && <Availability availability={product.availability} />}
      {
        (variant === 'store' || variant === 'related') && (
          <span class="more" aria-hidden="true">
            Ver detalles <Icon name="arrow-right" size={16} />
          </span>
        )
      }
      {
        variant === 'wishlist' && (
          <span class="cta" aria-hidden="true">
            Descubrir
          </span>
        )
      }
    </div>
  </div>
</Card>

<style is:global>
  @layer components {
    /* Raíz de Card: la clase llega por prop, así que el estilo con ámbito de Astro no la alcanza. */
    .product-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-16);
      height: 100%;
    }
    .product-card:has(a:focus-visible) {
      outline: var(--focus-ring);
      outline-offset: var(--focus-offset);
    }
    .product-card a:focus-visible {
      outline: none;
    }
    .product-card:hover {
      background: var(--color-ivory);
    }
    .product-card .media {
      position: relative;
      overflow: hidden;
      border-radius: var(--radius-sm);
      background: var(--color-mint);
    }
    .product-card .media img,
    .product-card .no-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .product-card .no-image {
      background: repeating-linear-gradient(45deg, var(--color-mint) 0 12px, var(--bg-surface) 12px 24px);
    }
    /* Acciones (corazón de lista de deseos) por encima del enlace extendido */
    .product-card .action {
      position: absolute;
      inset-block-start: var(--space-8);
      inset-inline-end: var(--space-8);
      z-index: 2;
    }
    .product-card .body {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: var(--space-4);
      min-width: 0;
    }
    .product-card .name {
      margin: 0;
      font-family: var(--font-heading);
      font-weight: var(--weight-semibold);
      font-size: var(--text-body-editorial);
      line-height: var(--leading-body-editorial);
      color: var(--text-primary);
    }
    /* Enlace extendido: un único <a> cubre toda la tarjeta */
    .product-card .name a {
      color: inherit;
      text-decoration: none;
    }
    .product-card .name a::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    .product-card .category,
    .product-card .spec {
      margin: 0;
      font-family: var(--font-ui);
      font-size: var(--text-body-ui);
      line-height: var(--leading-body-ui);
      color: var(--text-secondary);
    }
    .product-card .foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-8) var(--space-16);
      margin-block-start: auto;
      padding-block-start: var(--space-12);
      border-top: 1px solid var(--stroke-soft);
    }
    .product-card .more {
      display: inline-flex;
      align-items: center;
      gap: var(--space-8);
      margin-inline-start: auto;
      font-family: var(--font-editorial);
      font-size: var(--text-body-ui);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-primary);
    }
    .product-card .cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      width: 100%;
      min-height: var(--touch-target);
      border: 1.5px solid var(--color-ink);
      border-radius: var(--radius-pill);
      background: var(--color-yellow);
      font-family: var(--font-brand);
      font-size: var(--text-body-editorial);
      text-transform: uppercase;
      color: var(--color-ink);
    }
    /* Compacta: miniatura de 100 px a la izquierda */
    .product-card[data-variant='compact'] {
      flex-direction: row;
      align-items: center;
      gap: var(--space-12);
      min-height: var(--touch-target);
    }
    .product-card[data-variant='compact'] .media {
      flex: none;
      width: 100px;
    }
    .product-card[data-variant='compact'] .foot {
      border-top: 0;
      padding-block-start: 0;
    }
  }
</style>
