---
// "Destacado del mes": contenido de demostración, sin botón ni enlace (D-041 P-2).
// La fotografía del nodo 51:345 no se descarga (BRIEF §9): bloque de color.
import Price from '../ui/Price.astro';
import type { Money } from '../../lib/format';

interface Props {
  kicker: string;
  title: string;
  description?: string;
  price?: Money;
}
const { kicker, title, description, price } = Astro.props;
---

<aside class="banner" data-demo-content aria-label="Contenido de demostración">
  <div class="text">
    <p class="kicker">{kicker}</p>
    <p class="title">{title}</p>
    {description && <p class="description">{description}</p>}
    <div class="foot">
      {price && <Price price={price} size="lg" />}
      <span class="demo">Contenido de demostración</span>
    </div>
  </div>
  <div class="media" aria-hidden="true"><img src="/brand/symbol.svg" width="116" height="116" alt="" decoding="async" /></div>
</aside>

<style>
  @layer components {
    .banner {
      display: grid; /* 50/50 en escritorio: texto y bloque de color en lugar de la foto (D-07) */
      overflow: hidden;
      border-radius: var(--radius-lg);
      background: var(--color-ink);
      color: var(--text-on-dark);
    }
    .text {
      display: grid;
      align-content: center;
      gap: var(--space-8);
      padding: var(--space-32);
    }
    .media {
      display: grid;
      place-items: center;
      min-height: 120px;
      background: var(--color-forest-mid);
    }
    .media img {
      inline-size: 72px;
      block-size: auto;
    }
    @media (min-width: 800px) {
      .banner {
        grid-template-columns: 1fr 1fr;
      }
      .media img {
        inline-size: 120px;
      }
    }
    .kicker {
      font-family: var(--font-editorial);
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-caption);
      text-transform: uppercase;
      color: var(--color-yellow);
    }
    .title {
      font-family: var(--font-heading);
      font-weight: var(--weight-bold);
      font-size: var(--text-h3);
      line-height: var(--leading-h3);
      text-transform: uppercase;
    }
    .description {
      font-family: var(--font-ui);
      font-size: var(--text-body-ui);
      max-inline-size: 60ch;
    }
    .foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-12);
      color: var(--color-yellow);
    }
    .foot :global(.current) {
      color: var(--color-yellow);
    }
    .demo {
      font-family: var(--font-editorial);
      font-size: var(--text-caption);
      text-transform: uppercase;
      color: var(--text-on-dark);
    }
  }
</style>
