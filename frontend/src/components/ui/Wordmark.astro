---
interface Props {
  tone?: 'ink' | 'ivory';
  href?: string;
}
const { tone = 'ink', href } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class="wordmark" data-tone={tone} {...href ? { href, 'aria-label': 'Valmont, inicio' } : {}}>Valmont</Tag>

<style>
  @layer components {
    .wordmark {
      display: inline-block;
      font-family: var(--font-brand);
      font-weight: var(--weight-regular);
      font-size: var(--text-h3);
      line-height: 1;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      text-decoration: none;
      white-space: nowrap;
    }
    .wordmark[data-tone='ink'] {
      color: var(--color-ink);
    }
    .wordmark[data-tone='ivory'] {
      color: var(--color-ivory);
    }
    a.wordmark {
      min-height: var(--touch-target);
      line-height: var(--touch-target);
    }
  }
</style>
