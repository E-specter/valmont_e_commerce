---
interface Props {
  label: string;
  items: readonly { title: string; at: string; note?: string | null; actor?: string; current?: boolean }[];
}
const { label, items } = Astro.props;
---

<ol class="timeline" aria-label={label}>
  {
    items.map((it) => (
      <li class="item" aria-current={it.current ? 'step' : undefined}>
        <span class="marker" aria-hidden="true" />
        <div class="content">
          <strong class="title">{it.title}</strong>
          <span class="meta">
            <time>{it.at}</time>
            {it.actor && ` · ${it.actor}`}
          </span>
          {it.note && <p class="note">{it.note}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  @layer components {
    .timeline {
      margin: 0;
      padding: 0;
      list-style: none;
      font-family: var(--font-ui);
      font-size: var(--text-body-ui);
      color: var(--text-primary);
    }
    .item {
      position: relative;
      display: flex;
      gap: var(--space-16);
      padding-bottom: var(--space-24);
    }
    /* Línea vertical entre marcadores */
    .item:not(:last-child)::before {
      content: '';
      position: absolute;
      inset-block: var(--space-16) 0;
      inset-inline-start: calc(var(--size-dot) / 2);
      border-inline-start: 1px solid var(--stroke-default);
    }
    .marker {
      flex: none;
      width: var(--size-dot);
      height: var(--size-dot);
      margin-top: var(--space-4);
      border: var(--stroke-dot) solid var(--color-mint);
      border-radius: var(--radius-pill);
    }
    .item[aria-current='step'] .marker {
      background: var(--color-yellow);
      border-color: var(--color-yellow);
    }
    .content {
      display: grid;
      gap: var(--space-4);
      min-width: 0;
    }
    .title {
      font-weight: var(--weight-semibold);
    }
    .meta {
      color: var(--text-secondary);
      font-size: var(--text-caption);
    }
    .note {
      margin: 0;
      overflow-wrap: anywhere;
    }
  }
</style>
