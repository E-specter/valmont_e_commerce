---
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  label: string;
  options: readonly { value: string; label: string }[];
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  hint?: string;
}
const { id, name, label, options, value = '', placeholder, required, disabled, error, hint } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedby = [hintId, errorId].filter(Boolean).join(' ') || undefined;
---

<div class="field" data-invalid={error ? '' : undefined}>
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <div class="box">
    <select id={id} name={name} required={required} disabled={disabled} aria-invalid={error ? 'true' : undefined} aria-describedby={describedby}>
      {placeholder !== undefined && <option value="" selected={value === ''}>{placeholder}</option>}
      {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
    </select>
    <Icon name="chevron-down" size={20} />
  </div>
  {hint && <p class="hint" id={hintId}>{hint}</p>}
  {
    error && (
      <p class="error" id={errorId}>
        <Icon name="alert-triangle" size={16} />
        <span>{error}</span>
      </p>
    )
  }
</div>

<style>
  @layer components {
    .field {
      display: grid;
      gap: var(--space-8);
    }
    label {
      font-size: var(--text-caption);
      font-weight: var(--weight-bold);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .box {
      position: relative;
      display: flex;
      align-items: center;
    }
    .box > :global(.icon) {
      position: absolute;
      inset-inline-end: var(--space-12);
      color: var(--text-secondary);
      pointer-events: none;
    }
    select {
      appearance: none;
      inline-size: 100%;
      min-height: var(--touch-target);
      padding: var(--space-12) calc(var(--space-12) + var(--space-24) + var(--space-8)) var(--space-12) var(--space-16);
      border: 1px solid var(--stroke-control);
      border-radius: var(--radius-md);
      background: var(--bg-surface);
      color: var(--text-primary);
      font: inherit;
      font-size: var(--text-body-ui);
      line-height: var(--leading-body-ui);
      transition: border-color var(--dur-state) var(--ease);
    }
    select:hover {
      border-color: var(--stroke-strong);
    }
    select:focus {
      border-color: var(--text-primary);
      box-shadow: 0 0 0 1px var(--text-primary);
    }
    select:focus-visible {
      outline: var(--focus-ring);
      outline-offset: var(--focus-offset);
    }
    select[aria-invalid='true'] {
      border-color: var(--color-red-strong);
      box-shadow: 0 0 0 1px var(--color-red-strong);
    }
    select:disabled {
      border-style: dashed;
      color: var(--text-secondary);
      cursor: not-allowed;
    }
    .hint {
      color: var(--text-secondary);
      font-size: var(--text-caption);
    }
    .error {
      display: flex;
      align-items: flex-start;
      gap: var(--space-8);
      color: var(--color-red-strong);
      font-size: var(--text-caption);
      font-weight: var(--weight-medium);
    }
  }
</style>
