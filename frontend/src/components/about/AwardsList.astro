---
interface Props {
  items: { year: number; title: string; description?: string }[];
}
const { items } = Astro.props;
---

<ul class="awards">
  {
    items.map((item) => (
      <li class="award">
        <span class="award__year">{item.year}</span>
        <span class="award__body">
          <span class="award__title">{item.title}</span>
          {item.description && <span class="award__desc">{item.description}</span>}
        </span>
      </li>
    ))
  }
</ul>

<style>
  @layer components {
    .awards {
      container-type: inline-size;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .award {
      display: grid;
      gap: var(--space-4);
      padding-block: var(--space-16) var(--space-12);
      border-bottom: 1px solid var(--stroke-strong);
    }
    .award__year {
      font-family: var(--font-ui);
      font-weight: var(--weight-bold);
      font-size: var(--text-caption);
      line-height: var(--leading-caption);
    }
    .award__body {
      display: grid;
      gap: var(--space-4);
    }
    .award__title {
      font-family: var(--font-editorial);
      font-size: var(--text-h3);
      line-height: var(--leading-h3);
      letter-spacing: var(--tracking-h3);
      text-transform: uppercase;
    }
    .award__desc {
      font-family: var(--font-ui);
      font-size: var(--text-body-ui);
      line-height: var(--leading-body-ui);
      max-inline-size: 60ch;
    }
    @container (min-width: 480px) {
      .award {
        grid-template-columns: var(--space-64) 1fr;
        column-gap: var(--space-24);
        align-items: baseline;
      }
    }
  }
</style>
