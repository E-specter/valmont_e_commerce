---
import PageTitle from '../layout/PageTitle.astro';
import Button from '../ui/Button.astro';
import Checkerboard from '../ui/Checkerboard.astro';
import Field from '../ui/Field.astro';
import IconButton from '../ui/IconButton.astro';
import Notice from '../ui/Notice.astro';
import TextLink from '../ui/TextLink.astro';
import { SERVICE_UNAVAILABLE_MESSAGE } from '../../lib/auth-messages';

interface Props {
  mode: 'login';
  email?: string;
  errors?: { form?: string; email?: string; password?: string };
  next?: string;
}
const { email = '', errors = {}, next } = Astro.props;
// `next` ya llega validado por la página (safeNext); aquí solo se codifica.
const safe = next;
const registerHref = safe ? `/registro?next=${encodeURIComponent(safe)}` : '/registro';
const retryHref = safe ? `/ingresar?next=${encodeURIComponent(safe)}` : '/ingresar';
const hasErrors = Boolean(errors.form || errors.email || errors.password);
---

<section class="auth-form">
  <PageTitle
    tone="dark"
    kicker="Portal de autenticación segura"
    title="Ingreso"
    description="Accede a tu cuenta Valmont para gestionar tus pedidos y tu lista de deseos."
  />
  <form method="post" action="/ingresar" novalidate>
    {safe && <input type="hidden" name="next" value={safe} />}
    {
      hasErrors && (
        <Notice tone="error" tabindex="-1" autofocus>
          <p>{errors.form ?? 'Revisa los campos marcados.'}</p>
          {errors.form === SERVICE_UNAVAILABLE_MESSAGE && (
            <Button slot="actions" href={retryHref} variant="secondary">
              Reintentar
            </Button>
          )}
        </Notice>
      )
    }
    <Field
      id="email"
      name="email"
      type="email"
      label="Correo electrónico"
      iconLeft="mail"
      autocomplete="email"
      inputmode="email"
      maxlength={320}
      required
      value={email}
      tone="dark"
      error={errors.email}
    />
    <Field
      id="password"
      name="password"
      type="password"
      label="Contraseña"
      iconLeft="lock"
      autocomplete="current-password"
      maxlength={1024}
      required
      tone="dark"
      error={errors.password}
    >
      <IconButton
        slot="action"
        variant="plain"
        icon="eye"
        label="Mostrar contraseña"
        pressed={false}
        data-password-toggle
        aria-controls="password"
      />
    </Field>
    <Button type="submit" variant="mint" size="lg" fullWidth>Ingresar</Button>
    <p class="separator"><span>o</span></p>
    <p class="register"><TextLink tone="ivory" href={registerHref}>Crear cuenta Valmont +</TextLink></p>
  </form>
  <Checkerboard palette="auth" cell={16} />
</section>

<script>
  import { initPasswordToggle } from '../../islands/password-toggle';
  initPasswordToggle();
</script>

<style>
  @layer components {
    form {
      display: grid;
      gap: var(--space-24);
      padding-block-end: var(--space-32);
    }
    /* Sin JavaScript el botón del ojo no hace nada: solo se muestra cuando la isla lo activa. */
    form :global([data-password-toggle]:not([data-ready])) {
      display: none;
    }
    .separator {
      display: flex;
      align-items: center;
      gap: var(--space-16);
      margin: 0;
      color: var(--text-on-dark);
      font-size: var(--text-caption);
      text-transform: uppercase;
    }
    .separator::before,
    .separator::after {
      content: '';
      flex: 1;
      border-block-start: 1px solid var(--stroke-on-dark);
    }
    .register {
      margin: 0;
      text-align: center;
    }
  }
</style>
