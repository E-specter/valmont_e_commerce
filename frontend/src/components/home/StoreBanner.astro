---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  text: string;
  linkLabel: string;
  linkHref: string;
  image?: { src: ImageMetadata | string; alt: string } | null;
}
const { title, text, linkLabel, linkHref, image = null } = Astro.props;
---

<section class="banner" aria-labelledby="banner-title">
  <div class="banner__text">
    <h2 id="banner-title">{title}</h2>
    <p>{text}</p>
    <Button href={linkHref} variant="dark">{linkLabel}</Button>
  </div>
  <div class="banner__media">
    {
      image &&
        (typeof image.src === 'string' ? (
          <img src={image.src} alt={image.alt} width="1200" height="800" loading="lazy" decoding="async" />
        ) : (
          <Image src={image.src} alt={image.alt} widths={[600, 1200]} sizes="(min-width: 800px) 50vw, 100vw" loading="lazy" />
        ))
    }
  </div>
</section>

<style>
  @layer components {
    .banner {
      display: grid;
      margin-inline: calc(var(--page-margin) * -1);
    }
    .banner__text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-24);
      padding: var(--space-48) var(--page-margin);
    }
    h2 {
      font-family: var(--font-heading);
      font-weight: var(--weight-semibold);
      font-size: var(--text-h2);
      line-height: var(--leading-h2);
      letter-spacing: var(--tracking-h2);
      text-wrap: balance;
    }
    p {
      font-family: var(--font-editorial);
      font-size: var(--text-body-editorial);
      letter-spacing: var(--tracking-body-editorial);
      color: var(--text-secondary);
    }
    .banner__media {
      min-height: 240px;
      background: var(--color-forest); /* sin foto: bloque de color del token */
    }
    .banner__media :global(img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    @media (min-width: 800px) {
      .banner {
        grid-template-columns: 1fr 1fr;
      }
      .banner__text {
        justify-content: center;
      }
    }
  }
</style>
