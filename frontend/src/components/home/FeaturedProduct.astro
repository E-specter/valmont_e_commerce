---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Price from '../ui/Price.astro';
import type { ProductSummary } from '../../lib/api/catalog';

interface Props {
  product: ProductSummary;
  badge?: string;
  cta?: string;
}
const { product, badge = 'Novedad', cta = 'Ver reloj' } = Astro.props;
---

<section class="featured on-dark" aria-labelledby="featured-title">
  <img
    class="featured__img"
    src={product.main_image.url}
    alt={product.main_image.alt}
    width="1280"
    height="800"
    loading="lazy"
    decoding="async"
  />
  <div class="featured__body">
    <Badge kind="product">{badge}</Badge>
    <h2 id="featured-title">{product.name}</h2>
    <p class="featured__category">{product.category.name}</p>
    <Price price={product.price} originalPrice={product.original_price} size="lg" />
    <Button href={`/relojes/${encodeURIComponent(product.slug)}`}>{cta}<span class="sr-only">: {product.name}</span></Button>
  </div>
</section>

<style>
  @layer components {
    .featured {
      position: relative;
      display: flex;
      align-items: flex-end;
      margin-inline: calc(var(--page-margin) * -1);
      min-height: 560px;
      padding: var(--space-48) var(--page-margin);
      background: var(--color-forest-deep); /* sin imagen o mientras carga */
      color: var(--text-on-dark);
      isolation: isolate;
    }
    .featured__img {
      position: absolute;
      inset: 0;
      z-index: -2;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* Velo para garantizar contraste del texto sobre la foto */
    .featured::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(to top, var(--overlay-forest-strong), var(--overlay-forest-soft));
    }
    .featured__body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-12);
      /* El precio hereda los tokens de texto: sobre oscuro pasan a marfil */
      --text-primary: var(--color-ivory);
      --text-secondary: var(--color-ivory);
    }
    h2 {
      font-family: var(--font-heading);
      font-weight: var(--weight-bold);
      font-size: var(--text-display);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      overflow-wrap: anywhere;
    }
    .featured__category {
      font-family: var(--font-editorial);
      font-size: var(--text-body-editorial);
      letter-spacing: var(--tracking-body-editorial);
    }
  }
</style>
