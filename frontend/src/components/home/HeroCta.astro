---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Checkerboard from '../ui/Checkerboard.astro';

interface Props {
  title: string;
  ctaLabel: string;
  ctaHref: string;
  // Foto propia futura (sin marcas ajenas, D-044). Sin ella se muestra el bloque de marca.
  image?: { src: ImageMetadata | string; alt: string };
}
const { title, ctaLabel, ctaHref, image } = Astro.props;
// Con foto: es la imagen de LCP (carga inmediata, prioridad alta, nunca lazy, RNF03). Sin foto, el LCP es el titular.
const lcp = { loading: 'eager', fetchpriority: 'high', decoding: 'async', class: 'hero__img' } as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__text">
    <h1 id="hero-title">{title}</h1>
    <Button href={ctaHref} variant="dark" size="lg" iconRight="arrow-right">{ctaLabel}</Button>
  </div>
  <div class="hero__media">
    {
      !image ? (
        <div class="hero__brand">
          <img src="/brand/symbol.svg" width="116" height="116" alt="" decoding="async" />
          <Checkerboard rows={2} />
        </div>
      ) : typeof image.src === 'string' ? (
        <img src={image.src} alt={image.alt} width="1920" height="848" {...lcp} />
      ) : (
        <Image src={image.src} alt={image.alt} widths={[640, 1024, 1600]} sizes="(min-width: 800px) 60vw, 100vw" format="webp" {...lcp} />
      )
    }
  </div>
</section>

<style>
  @layer components {
    .hero {
      display: grid;
      margin-inline: calc(var(--page-margin) * -1);
      margin-block-start: var(--space-48); /* aire entre el damero y el hero (D-03) */
      background: var(--color-mint);
    }
    .hero__text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-24);
      padding: var(--space-24) var(--page-margin);
    }
    h1 {
      font-family: var(--font-heading);
      font-weight: var(--weight-semibold);
      font-size: var(--text-h2);
      line-height: var(--leading-h2);
      letter-spacing: var(--tracking-h2);
      color: var(--text-primary);
      text-wrap: balance;
    }
    .hero__media {
      aspect-ratio: 16 / 9;
      background: var(--color-forest);
    }
    .hero__brand {
      position: relative;
      display: grid;
      place-items: center;
      height: 100%;
      min-height: 180px;
    }
    .hero__brand img {
      inline-size: clamp(88px, 28%, 200px);
      block-size: auto;
    }
    .hero__brand :global(.checkerboard) {
      position: absolute;
      inset-block-end: 0;
    }
    .hero__media :global(.hero__img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: left center; /* el reloj queda en el borde izquierdo de la foto */
    }
    @media (min-width: 800px) {
      .hero {
        grid-template-columns: minmax(0, 1fr) minmax(0, 540px);
        min-height: 540px;
      }
      .hero__text {
        justify-content: space-between;
        padding: var(--space-32);
      }
      .hero__media {
        order: -1;
        aspect-ratio: auto;
      }
    }
  }
</style>
