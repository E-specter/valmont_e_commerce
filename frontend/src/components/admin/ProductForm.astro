---
// Formulario de producto (bo/05, `201:748`): crear y editar con el mismo marco. Recibe todo por props
// (RT-B6). Las imágenes (T-148) y el panel de publicación entran por slots, fuera del <form>: no se anidan formularios.
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Field from '../ui/Field.astro';
import Notice from '../ui/Notice.astro';
import RadioGroup from '../ui/RadioGroup.astro';
import Select from '../ui/Select.astro';
import Textarea from '../ui/Textarea.astro';
import SpecsEditor from './SpecsEditor.astro';
import type { AdminAttributeValue, AdminCategory } from '../../lib/api/admin-catalog';
import { MAX_SPECS, MSG_NO_CHANGES, MSG_SAVE_FIRST, type ProductFormErrors, type ProductFormValues } from '../../lib/admin/product-form';

interface Props {
  mode: 'create' | 'edit';
  values: ProductFormValues;
  errors?: ProductFormErrors;
  categories: readonly AdminCategory[];
  movements: readonly AdminAttributeValue[];
  caseMaterials: readonly AdminAttributeValue[];
  saved?: 'created' | 'updated' | 'unchanged';
}
const { mode, values: v, errors = {}, categories, movements, caseMaterials, saved } = Astro.props;

const LABELS: Record<keyof ProductFormValues, string> = {
  sku: 'SKU', slug: 'Slug (dirección)', name: 'Nombre', description: 'Descripción', category_id: 'Categoría', price: 'Precio',
  order_policy: 'Política de venta', lead_time_days: 'Plazo de entrega', movement_code: 'Movimiento', case_material_code: 'Material de la caja',
  case_diameter_mm: 'Diámetro de la caja', water_resistance_m: 'Resistencia al agua', specs: 'Especificaciones',
};
const FIELD_ID: Partial<Record<keyof ProductFormValues, string>> = { order_policy: 'order_policy' };
const summary = (Object.keys(LABELS) as (keyof ProductFormValues)[])
  .filter((k) => errors[k])
  .map((k) => ({ href: `#${FIELD_ID[k] ?? (k === 'specs' ? 'specs-titulo' : `pf-${k}`)}`, label: LABELS[k], message: errors[k] as string }));
const hasSummary = summary.length > 0 || Boolean(errors.form);

const categoryOptions = categories.filter((c) => c.is_active || c.id === v.category_id).map((c) => ({ value: c.id, label: c.name }));
const attrOptions = (items: readonly AdminAttributeValue[], current: string) =>
  items.filter((a) => a.is_active || a.code === current).map((a) => ({ value: a.code, label: a.label }));
const policies = [
  { value: 'stock', label: 'Solo con stock' },
  { value: 'made_to_order', label: 'Siempre bajo pedido' },
  { value: 'backorder', label: 'Con stock y, agotado, bajo pedido' },
];
const specErrors: Record<number, string> = errors.specs ? { 0: errors.specs } : {};
---

<div class="layout">
  <div class="main">
    {saved === 'created' && <Notice tone="success">Producto creado como borrador.</Notice>}
    {saved === 'updated' && <Notice tone="success">Cambios guardados.</Notice>}
    {saved === 'unchanged' && <Notice tone="info">{MSG_NO_CHANGES}</Notice>}
    {
      hasSummary && (
        <div id="resumen-errores" class="summary" role="alert" tabindex="-1" data-error-summary>
          <strong>{errors.form ?? 'Revisa los campos marcados.'}</strong>
          {summary.length > 0 && (
            <ul>
              {summary.map((s) => <li><a href={s.href}>{s.label}: {s.message}</a></li>)}
            </ul>
          )}
        </div>
      )
    }
    <form id="product-form" method="post" novalidate data-busy-on-submit data-unsaved-guard>
      <input type="hidden" name="_action" value="save" />

      <Card as="section" aria-labelledby="datos-titulo">
        <h2 id="datos-titulo">Datos</h2>
        <div class="grid">
          <Field id="pf-sku" name="sku" label="SKU" value={v.sku} required maxlength={40} error={errors.sku} autocomplete="off" />
          <Field id="pf-slug" name="slug" label="Slug (dirección)" value={v.slug} error={errors.slug} autocomplete="off" hint="Se genera del nombre si lo dejas vacío. Tras publicar no se puede cambiar." />
          <div class="wide"><Field id="pf-name" name="name" label="Nombre" value={v.name} required maxlength={120} error={errors.name} hint="Hasta 120 caracteres." /></div>
          <div class="wide"><Select id="pf-category_id" name="category_id" label="Categoría" options={categoryOptions} value={v.category_id} placeholder="Elige una categoría" required error={errors.category_id} hint="Solo categorías activas permiten publicar." /></div>
          <div class="wide"><Textarea id="pf-description" name="description" label="Descripción" value={v.description} rows={6} maxlength={5000} error={errors.description} hint="Hasta 5000 caracteres. Obligatoria para publicar." /></div>
        </div>
      </Card>

      <Card as="section" aria-labelledby="precio-titulo">
        <h2 id="precio-titulo">Precio y venta</h2>
        <div class="grid">
          <Field id="pf-price" name="price" label="Precio (S/)" value={v.price} required inputmode="decimal" autocomplete="off" error={errors.price} hint="El servidor guarda el importe en céntimos." />
          <Field id="pf-lead_time_days" name="lead_time_days" label="Plazo de entrega (días)" value={v.lead_time_days} inputmode="numeric" autocomplete="off" error={errors.lead_time_days} />
          <div class="wide"><RadioGroup name="order_policy" legend="Política de venta" options={policies} value={v.order_policy} error={errors.order_policy} /></div>
        </div>
      </Card>

      <Card as="section" aria-labelledby="atributos-titulo">
        <h2 id="atributos-titulo">Atributos</h2>
        <div class="grid">
          <Select id="pf-movement_code" name="movement_code" label="Movimiento" options={attrOptions(movements, v.movement_code)} value={v.movement_code} placeholder="Sin especificar" error={errors.movement_code} />
          <Select id="pf-case_material_code" name="case_material_code" label="Material de la caja" options={attrOptions(caseMaterials, v.case_material_code)} value={v.case_material_code} placeholder="Sin especificar" error={errors.case_material_code} />
          <Field id="pf-case_diameter_mm" name="case_diameter_mm" label="Diámetro de la caja (mm)" value={v.case_diameter_mm} inputmode="decimal" autocomplete="off" error={errors.case_diameter_mm} hint="Hasta 999,9 con un decimal." />
          <Field id="pf-water_resistance_m" name="water_resistance_m" label="Resistencia al agua (m)" value={v.water_resistance_m} inputmode="numeric" autocomplete="off" error={errors.water_resistance_m} />
        </div>
      </Card>

      <Card as="section" aria-labelledby="specs-titulo">
        <div class="head"><h2 id="specs-titulo" tabindex="-1">Especificaciones</h2><span class="count"><span data-specs-count>{v.specs.length}</span> de {MAX_SPECS}</span></div>
        <SpecsEditor specs={v.specs} errors={specErrors} max={MAX_SPECS} />
      </Card>

      {mode === 'create' && (
        <div class="actions">
          <Button type="submit">Crear producto</Button>
          <Button href="/admin/productos" variant="ghost">Cancelar</Button>
        </div>
      )}
    </form>

    <Card as="section" aria-labelledby="imagenes-titulo">
      <div class="head"><h2 id="imagenes-titulo">Imágenes</h2>{mode === 'edit' && <span class="count">La primera es la principal</span>}</div>
      {mode === 'create' ? <Notice tone="info">{MSG_SAVE_FIRST}</Notice> : <slot name="images" />}
    </Card>
  </div>
  <aside class="side" aria-label="Publicación">
    <slot name="panel" />
  </aside>
</div>

<script>
  import { initFormBusy } from '../../islands/form-busy';
  import { initSpecsEditor } from '../../islands/specs-editor';
  import { initUnsavedChanges } from '../../islands/unsaved-changes';

  initFormBusy();
  initSpecsEditor();
  initUnsavedChanges();
  document.getElementById('resumen-errores')?.focus();
</script>

<style>
  @layer components {
    .layout {
      display: grid;
      gap: var(--space-24);
      align-items: start;
    }
    @media (min-width: 64rem) {
      .layout {
        grid-template-columns: minmax(0, 1fr) 340px;
      }
      .side {
        position: sticky;
        inset-block-start: var(--space-24);
      }
    }
    .main,
    form {
      display: grid;
      gap: var(--space-24);
    }
    .head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-12);
      margin-block-end: var(--space-16);
    }
    .count {
      color: var(--text-secondary);
      font-size: var(--text-caption);
    }
    h2 {
      margin: 0;
      font-family: var(--font-ui);
      font-size: var(--text-body-ui);
      font-weight: var(--weight-bold);
    }
    .grid {
      display: grid;
      gap: var(--space-16);
    }
    @media (min-width: 40rem) {
      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .wide {
        grid-column: 1 / -1;
      }
    }
    .summary {
      padding: var(--space-12) var(--space-16);
      border: 1px solid var(--color-red-strong);
      border-radius: var(--radius-md);
      background: var(--bg-surface);
      color: var(--text-primary);
    }
    .summary:focus-visible {
      outline: var(--focus-ring);
      outline-offset: var(--focus-offset);
    }
    .summary ul {
      margin: var(--space-8) 0 0;
      padding-inline-start: var(--space-24);
    }
    .summary a {
      color: inherit;
      text-underline-offset: 0.2em;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-12);
    }
  }
</style>
