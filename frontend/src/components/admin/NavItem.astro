---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';

interface Props {
  label: string;
  href?: string;
  icon: IconName;
  current?: boolean;
  disabled?: boolean;
  hint?: string;
}
const { label, href, icon, current = false, disabled = false, hint } = Astro.props;
// D-B1: un módulo sin pantalla se pinta sin href (no navega ni entra en el orden de tabulación).
const inactive = disabled || !href;
const Tag = inactive ? 'span' : 'a';
---

<li class="nav-item">
  <Tag
    class="nav-item__link"
    {...inactive ? { 'aria-disabled': 'true' } : { href, 'aria-current': current ? 'page' : undefined }}
    data-current={current && !inactive ? 'true' : undefined}
  >
    <Icon name={icon} size={24} />
    <span class="nav-item__label">{label}</span>
    {hint && <span class="nav-item__hint">{hint}</span>}
  </Tag>
</li>

<style>
  @layer components {
    .nav-item {
      list-style: none;
    }
    .nav-item__link {
      position: relative;
      display: flex;
      align-items: center;
      gap: var(--space-12);
      min-block-size: var(--size-control);
      padding-inline: var(--space-24) var(--space-16);
      color: var(--text-primary);
      font-family: var(--font-ui);
      font-size: var(--text-body-ui);
      font-weight: var(--weight-medium);
      line-height: var(--leading-body-ui);
      text-decoration: none;
    }
    a.nav-item__link:hover {
      background: var(--bg-surface-raised);
    }
    /* El foco queda dentro de la fila: la barra lateral recorta lo que sobresale */
    .nav-item__link:focus-visible {
      outline-offset: calc(var(--focus-offset) * -1);
    }
    .nav-item__link[data-current='true'] {
      background: var(--bg-surface-raised);
      font-weight: var(--weight-semibold);
    }
    .nav-item__link[data-current='true']::before {
      content: '';
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      inline-size: var(--space-4);
      background: var(--color-yellow);
    }
    .nav-item__link[aria-disabled='true'] {
      color: var(--text-secondary);
      cursor: default;
    }
    .nav-item__hint {
      margin-inline-start: auto;
      font-size: var(--text-caption);
      line-height: var(--leading-caption);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
  }
</style>
