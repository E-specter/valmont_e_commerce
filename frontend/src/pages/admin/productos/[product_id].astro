---
// Editar producto y publicarlo (T-147). SSR con POST y PRG (D-050); `_action` = save | publish | unpublish.
// La sección de imágenes (slot `images`) es de T-148.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/admin/ProductForm.astro';
import TextLink from '../../../components/ui/TextLink.astro';
import PublishPanel from '../../../components/admin/PublishPanel.astro';
import {
  getAdminAttributes,
  getAdminProduct,
  listAdminCategories,
  publishProduct,
  unpublishProduct,
  updateProduct,
  type AdminProduct,
} from '../../../lib/api/admin-catalog';
import { ApiError } from '../../../lib/api/http';
import { MSG_UNAVAILABLE } from '../../../lib/admin/messages';
import {
  diffProduct,
  readProductForm,
  saveErrors,
  parseFormLists,
  toProductValues,
  validateProductForm,
  type ProductFormErrors,
} from '../../../lib/admin/product-form';
import { adminErrorResponse, checkAdminOrigin, isUuid, requireAdmin, seeOther } from '../../../lib/server/admin';

export const prerender = false;

const NO_STORE = { 'Cache-Control': 'private, no-store' };
const UNPROCESSABLE = 422;
const UNAVAILABLE = 503;
const CLIENT_ERROR = 400;
const SERVER_ERROR = 500;
const PUBLISH_UNMET = 'publish_requirements_unmet';
const isPost = Astro.request.method === 'POST';
Astro.response.headers.set('Cache-Control', NO_STORE['Cache-Control']);

const productId = Astro.params.product_id ?? '';
if (!isUuid(productId)) return Astro.rewrite('/404');
const here = `/admin/productos/${encodeURIComponent(productId)}`;

if (isPost && !checkAdminOrigin(Astro.request, Astro.url)) {
  return new Response('Origen no permitido', { status: 403, headers: NO_STORE });
}
const gate = await requireAdmin(Astro);
if (!gate.ok) return gate.response;
const { api, profile } = gate.ctx;

const statusOf = (e: unknown) => (e instanceof ApiError && e.status >= CLIENT_ERROR && e.status < SERVER_ERROR ? e.status : UNAVAILABLE);

let product: AdminProduct;
try {
  product = await getAdminProduct(api, productId);
} catch (e) {
  return (await adminErrorResponse(Astro, e)) ?? Astro.rewrite('/admin/no-disponible');
}
// Un 200 con `null`, `{}` o un arreglo es un fallo del servicio: 503, nunca 500.
const p = product as Partial<AdminProduct> | null;
if (!p || typeof p !== 'object' || typeof p.id !== 'string' || typeof p.name !== 'string' || typeof p.sku !== 'string'
  || typeof p.price?.amount !== 'number' || !Array.isArray(p.specs) || (p.status !== 'draft' && p.status !== 'published')) {
  return Astro.rewrite('/admin/no-disponible');
}

let values = toProductValues(product);
let errors: ProductFormErrors = {};
let missing: string[] = [];
let panelError: string | undefined;

if (isPost) {
  let fd: FormData;
  try {
    fd = await Astro.request.clone().formData();
  } catch {
    return new Response('Tipo de contenido no admitido', { status: 415, headers: NO_STORE });
  }
  const action = fd.get('_action');
  if (action === 'save') {
    values = readProductForm(fd);
    const checked = validateProductForm(values);
    if (!checked.ok) {
      errors = checked.errors;
      Astro.response.status = UNPROCESSABLE;
    } else {
      const patch = diffProduct(toProductValues(product), values);
      if (Object.keys(patch).length === 0) return seeOther(`${here}?guardado=sin-cambios`);
      try {
        await updateProduct(api, productId, patch);
        return seeOther(`${here}?guardado=1`);
      } catch (e) {
        const early = await adminErrorResponse(Astro, e);
        if (early) return early;
        errors = saveErrors(e) ?? { form: MSG_UNAVAILABLE };
        Astro.response.status = statusOf(e);
      }
    }
  } else if (action === 'publish' || action === 'unpublish') {
    try {
      await (action === 'publish' ? publishProduct : unpublishProduct)(api, productId);
      return seeOther(`${here}?guardado=1`);
    } catch (e) {
      const early = await adminErrorResponse(Astro, e);
      if (early) return early;
      const list = e instanceof ApiError && e.code === PUBLISH_UNMET ? (e.details as { missing?: unknown } | null)?.missing : null;
      if (Array.isArray(list)) missing = list.filter((m): m is string => typeof m === 'string');
      else panelError = saveErrors(e)?.form ?? MSG_UNAVAILABLE;
      Astro.response.status = statusOf(e);
    }
  } else {
    return new Response('Acción no válida', { status: CLIENT_ERROR, headers: NO_STORE });
  }
}

let lists: ReturnType<typeof parseFormLists>;
try {
  const [categories, attrs] = await Promise.all([listAdminCategories(api), getAdminAttributes(api)]);
  lists = parseFormLists(categories, attrs);
} catch (e) {
  return (await adminErrorResponse(Astro, e)) ?? Astro.rewrite('/admin/no-disponible');
}

const flash = Astro.url.searchParams.get('creado') === '1' ? 'created' : Astro.url.searchParams.get('guardado');
const saved = isPost ? undefined : flash === 'created' ? 'created' : flash === '1' ? 'updated' : flash === 'sin-cambios' ? 'unchanged' : undefined;
if (!lists) return Astro.rewrite('/admin/no-disponible');
---

<AdminLayout
  title="Editar producto"
  section="productos"
  crumbs={[{ label: 'Productos', href: '/admin/productos' }, { label: 'Editar producto' }]}
  userName={profile.full_name}
  description={`${product.name} · SKU ${product.sku}`}
>
  <TextLink href="/admin/productos" tone="ivory">Volver a productos</TextLink>
  <ProductForm mode="edit" values={values} errors={errors} saved={saved} {...lists}>
    <PublishPanel slot="panel" productId={product.id} status={product.status} missing={missing} error={panelError} />
  </ProductForm>
</AdminLayout>
