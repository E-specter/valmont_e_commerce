---
// Muestrario de T-123. Solo existe en desarrollo: en producción responde 404. Datos de ejemplo, sin API.
import StoreLayout from '../../layouts/StoreLayout.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import DefinitionList from '../../components/ui/DefinitionList.astro';
import Pagination from '../../components/ui/Pagination.astro';
import type { ProductSummary } from '../../lib/api/catalog';

export const prerender = false;

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}

const pen = (amount: number) => ({ amount, currency: 'PEN' as const });
const placeholder = (hue: string) =>
  `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="320" height="400"><rect width="320" height="400" fill="${hue}"/><circle cx="160" cy="200" r="80" fill="none" stroke="black" stroke-width="6"/></svg>`)}`;
const base = {
  category: { slug: 'automaticos', name: 'Clásica' },
  original_price: null,
  discount_amount: null,
  water_resistance_m: 100,
} as const;
const products: ProductSummary[] = [
  {
    ...base,
    id: '1',
    slug: 'tourbillon-2026',
    sku: 'TC-2026-A',
    name: 'Tourbillon Aurora',
    price: pen(8450000),
    movement: { code: 'automatic', label: 'Automático' },
    case_material: { code: 'gold', label: 'Oro Amarillo 18K' },
    case_diameter_mm: 40,
    main_image: { id: 'i1', url: placeholder('honeydew'), alt: 'Tourbillon Aurora de oro amarillo, vista frontal' },
    availability: { status: 'in_stock', lead_time_days: null },
  },
  {
    ...base,
    id: '2',
    slug: 'calendario-perpetuo',
    sku: 'CP-100',
    name: 'Calendario Perpetuo',
    price: pen(1062550),
    original_price: pen(1250000),
    discount_amount: pen(187450),
    movement: { code: 'manual', label: 'Cuerda manual' },
    case_material: null,
    case_diameter_mm: 38,
    main_image: { id: 'i2', url: placeholder('lemonchiffon'), alt: 'Calendario Perpetuo con esfera blanca' },
    availability: { status: 'low_stock', lead_time_days: null },
  },
  {
    ...base,
    id: '3',
    slug: 'cronografo-agotado',
    sku: 'CR-7',
    name: 'Cronógrafo Meridiano con un nombre largo para probar el ajuste de línea',
    price: pen(3200000),
    movement: null,
    case_material: null,
    case_diameter_mm: null,
    main_image: { id: 'i3', url: placeholder('lavender'), alt: 'Cronógrafo Meridiano de acero' },
    availability: { status: 'out_of_stock', lead_time_days: null },
  },
  {
    ...base,
    id: '4',
    slug: 'minuto-repetidor',
    sku: 'MR-1',
    name: 'Minutero Repetidor',
    price: pen(15990000),
    movement: { code: 'automatic', label: 'Automático' },
    case_material: { code: 'platinum', label: 'Platino' },
    case_diameter_mm: 42,
    main_image: { id: 'i4', url: '', alt: 'Minutero Repetidor' },
    availability: { status: 'on_request', lead_time_days: 45 },
  },
];
const variants = ['store', 'related', 'wishlist', 'compact'] as const;
const href = (n: number) => `?page=${n}`;
const pagers = [
  { label: 'Una página (no se pinta)', page: 1, total: 10 },
  { label: 'Primera de 3', page: 1, total: 36 },
  { label: 'Intermedia de 12', page: 6, total: 144 },
  { label: 'Última de 12', page: 12, total: 144 },
  { label: 'Cerca del inicio, de 12', page: 3, total: 144 },
];
---

<StoreLayout title="Productos (desarrollo)" noindex>
  <h1>Productos, migas y paginación</h1>

  <section aria-labelledby="s-bc">
    <h2 id="s-bc">Breadcrumb</h2>
    <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Relojes', href: '/relojes' }, { label: 'Tourbillon Aurora' }]} />
  </section>

  {
    variants.map((variant) => (
      <section aria-labelledby={`s-${variant}`}>
        <h2 id={`s-${variant}`}>ProductCard · {variant}</h2>
        <ProductGrid products={products} variant={variant} label={`Relojes de ejemplo (${variant})`} headingLevel={3} />
      </section>
    ))
  }

  <section aria-labelledby="s-dl">
    <h2 id="s-dl">DefinitionList</h2>
    <DefinitionList
      columns={2}
      items={[
        { term: 'Referencia', description: 'TC-2026-A' },
        { term: 'Movimiento', description: 'Automático' },
        { term: 'Diámetro', description: '40 mm' },
        { term: 'Material de caja', description: 'Oro Amarillo 18K' },
      ]}
    />
  </section>

  <section aria-labelledby="s-pg">
    <h2 id="s-pg">Pagination</h2>
    {
      pagers.map((p) => (
        <div class="pager">
          <p>{p.label}</p>
          <Pagination page={p.page} pageSize={12} total={p.total} hrefFor={href} />
        </div>
      ))
    }
  </section>
</StoreLayout>

<style>
  section {
    margin-block: var(--space-32);
  }
  .pager {
    margin-block: var(--space-16);
  }
</style>
