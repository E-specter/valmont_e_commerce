---
// Muestrario de ui/ lote 1B (T-118). Solo existe en desarrollo: en producción responde 404.
import StoreLayout from '../../layouts/StoreLayout.astro';
import Availability from '../../components/ui/Availability.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import Chip from '../../components/ui/Chip.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Notice from '../../components/ui/Notice.astro';
import Price from '../../components/ui/Price.astro';
import Skeleton from '../../components/ui/Skeleton.astro';

export const prerender = false;

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}

const pen = (amount: number) => ({ amount, currency: 'PEN' as const });
const statuses = [
  { status: 'in_stock', lead_time_days: null },
  { status: 'low_stock', lead_time_days: null },
  { status: 'out_of_stock', lead_time_days: null },
  { status: 'on_request', lead_time_days: 45 },
  { status: 'on_request', lead_time_days: null },
] as const;
const notices = ['info', 'success', 'warning', 'error'] as const;
---

<StoreLayout title="Componentes ui B (desarrollo)" noindex>
  <h1>ui/ lote 1B</h1>

  <section aria-labelledby="s-card">
    <h2 id="s-card">Card</h2>
    <div class="row">
      <Card as="article"><p>Superficie, borde fuerte</p></Card>
      <Card outline="soft" padding="lg"><p>Borde suave, relleno grande</p></Card>
      <Card tone="forest"><p>Forest</p></Card>
      <Card tone="ink" padding="sm"><p>Ink</p></Card>
    </div>
  </section>

  <section aria-labelledby="s-badge">
    <h2 id="s-badge">Badge</h2>
    <div class="row">
      <Badge tone="yellow">En tránsito</Badge>
      <Badge tone="forest">Entregado</Badge>
      <Badge>En preparación</Badge>
      <Badge tone="plum">Cancelado</Badge>
      <Badge tone="mint">Pagado</Badge>
      <Badge tone="red">Rechazado</Badge>
      <Badge kind="product">Nuevo</Badge>
      <Badge kind="product">Edición limitada</Badge>
      <Badge kind="count">3</Badge>
    </div>
  </section>

  <section aria-labelledby="s-chip">
    <h2 id="s-chip">Chip</h2>
    <div class="row">
      <Chip label="Complicación" href="#" />
      <Chip label="Activo" href="#" active />
      <Chip label="Con quitar" href="#" active removeHref="#" />
      <Chip label="Amarillo" href="#" tone="yellow" />
      <Chip label="Menta" href="#" tone="mint" />
      <Chip label="Rojo" href="#" tone="red" />
      <Chip label="Botón" as="button" />
      <Chip label="Deshabilitado" as="span" />    </div>
  </section>

  <section aria-labelledby="s-price">
    <h2 id="s-price">Price</h2>
    <div class="row">
      <Price price={pen(8450000)} size="sm" />
      <Price price={pen(8450000)} />
      <Price price={pen(1062550)} size="lg" />
      <Price price={pen(7605000)} originalPrice={pen(8450000)} discountAmount={pen(845000)} />
      <Price price={pen(5)} originalPrice={pen(1000)} discountAmount={pen(995)} align="end" />
    </div>
  </section>

  <section aria-labelledby="s-avail">
    <h2 id="s-avail">Availability</h2>
    <div class="col">
      {statuses.map((a) => <Availability availability={a} />)}
      <Availability availability={statuses[0]} showLabel={false} />
    </div>
  </section>

  <section aria-labelledby="s-notice">
    <h2 id="s-notice">Notice</h2>
    <div class="col">
      {
        notices.map((tone) => (
          <Notice tone={tone} title="Título del aviso">
            <p>Texto del aviso con la consecuencia y qué hacer.</p>
            <Button slot="actions" variant="secondary" href="#">Reintentar</Button>
          </Notice>
        ))
      }
      <Notice><p>Aviso sin título ni acciones.</p></Notice>
    </div>
  </section>

  <section aria-labelledby="s-empty">
    <h2 id="s-empty">EmptyState</h2>
    <EmptyState title="Sin resultados" description="Prueba con otros filtros." icon="search">
      <Button slot="action" href="#">Limpiar filtros</Button>
    </EmptyState>
    <EmptyState title="Nivel 3" headingLevel={3} />
  </section>

  <section aria-labelledby="s-skel">
    <h2 id="s-skel">Skeleton</h2>
    <div class="col">
      <Skeleton />
      <Skeleton lines={3} />
      <Skeleton variant="block" width="50%" />
      <Skeleton variant="card" />
    </div>
  </section>
</StoreLayout>

<style>
  section {
    margin-block: var(--space-48);
    display: grid;
    gap: var(--space-16);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
  }
  .col {
    display: grid;
    gap: var(--space-12);
    justify-items: start;
  }
  .col > :global(.notice),
  .col > :global(.skeleton) {
    justify-self: stretch;
  }
</style>
