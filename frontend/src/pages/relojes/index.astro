---
import StoreLayout from '../../layouts/StoreLayout.astro';
import PageTitle from '../../components/layout/PageTitle.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Pagination from '../../components/ui/Pagination.astro';
import Notice from '../../components/ui/Notice.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Button from '../../components/ui/Button.astro';
import TextLink from '../../components/ui/TextLink.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import FilterBar from '../../components/catalog/FilterBar.astro';
import ActiveFilters from '../../components/catalog/ActiveFilters.astro';
import FeaturedBanner from '../../components/catalog/FeaturedBanner.astro';
import { featured } from '../../data/featured';
import { serverTransport } from '../../lib/api/server';
import { ApiError, type Page } from '../../lib/api/http';
import { getAttributes, listCategories, listProducts, type ProductSummary } from '../../lib/api/catalog';
import { activeChips, catalogHref, parseCatalogQuery, PAGE_SIZE } from '../../lib/catalog/query';

export const prerender = false;

const { query, filters, invalid } = parseCatalogQuery(Astro.url.searchParams);
const rangeError = query.price_min_soles !== undefined && query.price_max_soles !== undefined && query.price_min_soles > query.price_max_soles;
const retryHref = Astro.url.pathname + Astro.url.search;

let result: Page<ProductSummary> | null = null;
let categories: Awaited<ReturnType<typeof listCategories>> = [];
let attrs: Awaited<ReturnType<typeof getAttributes>> = { movements: [], case_materials: [] };
let failure: 'validation' | 'unavailable' | null = null;

if (!rangeError) {
  const t = serverTransport(); // catálogo público: sin sesión ni datos por usuario
  try {
    [result, categories, attrs] = await Promise.all([listProducts(t, filters), listCategories(t), getAttributes(t)]);
  } catch (e) {
    failure = e instanceof ApiError && e.status === 422 ? 'validation' : 'unavailable';
  }
}

// Página fuera de rango: se redirige a la última (decisión del desarrollador).
if (result && result.items.length === 0 && result.total > 0 && query.page > 1) {
  return Astro.redirect(catalogHref({ ...query, page: Math.ceil(result.total / PAGE_SIZE) }), 302);
}

// Solo la respuesta correcta se cachea; un error nunca.
if (failure === 'unavailable') Astro.response.status = 502;
Astro.response.headers.set(
  'Cache-Control',
  failure || rangeError ? 'no-store' : 'public, max-age=30, stale-while-revalidate=60',
);

const chips = activeChips(query, { categories, movements: attrs.movements, case_materials: attrs.case_materials });
const categoryName = query.category ? categories.find((c) => c.slug === query.category)?.name : undefined;
const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Relojes', ...(categoryName ? { href: '/relojes' } : {}) },
  ...(categoryName ? [{ label: categoryName }] : []),
];
const total = result?.total;
---

<StoreLayout title="Relojes | Valmont" description="Explora los relojes mecánicos de Valmont: filtra por colección, movimiento, material y precio.">
  <Breadcrumb items={crumbs} />
  <PageTitle title="Nuestros relojes" kicker="Colección">
    <p slot="meta" role="status" class="count">
      {total !== undefined && `${total} ${total === 1 ? 'modelo' : 'modelos'}`}
    </p>
  </PageTitle>
  <div class="stack">
  <FeaturedBanner {...featured} />
  <FilterBar categories={categories} movements={attrs.movements} materials={attrs.case_materials} query={query} />
  <ActiveFilters chips={chips} clearHref="/relojes" />
  </div>

  <section class="results" aria-label="Resultados">
    {
      (rangeError || invalid) && (
        <Notice tone="error" title="Revisa los filtros">
          {rangeError ? 'El precio mínimo no puede superar al máximo.' : 'Algunos valores de la URL no son válidos y se ignoraron.'}
          <TextLink slot="actions" href="/relojes">Limpiar filtros</TextLink>
        </Notice>
      )
    }
    {
      failure === 'validation' && (
        <Notice tone="error" title="Revisa los filtros">
          No pudimos aplicar esos filtros.
          <TextLink slot="actions" href="/relojes">Limpiar filtros</TextLink>
        </Notice>
      )
    }
    {
      failure === 'unavailable' && (
        <Notice tone="error" title="No pudimos cargar los relojes">
          Inténtalo de nuevo en unos instantes.
          <TextLink slot="actions" href={retryHref}>Reintentar</TextLink>
        </Notice>
      )
    }
    {
      result && result.items.length === 0 && (
        <EmptyState title="Ningún reloj coincide con tu búsqueda" description="Prueba con otros filtros o quita los que tienes activos.">
          <Button slot="action" href="/relojes" variant="secondary">Limpiar filtros</Button>
        </EmptyState>
      )
    }
    {result && result.items.length > 0 && <ProductGrid products={result.items} label="Relojes" headingLevel={2} />}
    {
      result && (<Pagination page={result.page} pageSize={result.page_size} total={result.total} hrefFor={(n) => catalogHref({ ...query, page: n })} />)
    }
  </section>
</StoreLayout>

<style>
  @layer components {
    .count {
      font-family: var(--font-editorial);
      text-transform: uppercase;
      color: var(--text-secondary);
    }
    .stack {
      display: grid;
      gap: var(--space-24);
    }
    .results {
      display: grid;
      gap: var(--space-32);
      padding-block: var(--space-32) var(--space-64);
    }
  }
</style>
