---
// Nosotros: página estática (T-122). Contenido de demostración (P-9, D-041).
export const prerender = true;
import StoreLayout from '../layouts/StoreLayout.astro';
import Badge from '../components/ui/Badge.astro';
import AwardsList from '../components/about/AwardsList.astro';
import ContactBlock from '../components/about/ContactBlock.astro';
import { SITE } from '../lib/site';
import { about } from '../data/about';
---

<StoreLayout title="Nosotros · Valmont" description={about.hero.text}>
  <header class="hero" data-demo-content>
    <p class="hero__kicker">{about.hero.kicker}</p>
    <h1>{about.hero.title}</h1>
    <p class="hero__text">{about.hero.text}</p>
    <Badge tone="mint">{about.demoLabel}</Badge>
  </header>

  <section class="awards" aria-labelledby="awards-title" data-demo-content>
    <div class="awards__list">
      <h2 id="awards-title">{about.awards.title}</h2>
      <AwardsList items={[...about.awards.items]} />
      <Badge>{about.demoLabel}</Badge>
    </div>
    <div class="awards__block" aria-hidden="true">{about.placeholder}</div>
  </section>

  <div data-demo-content>
    <ContactBlock phone={SITE.phone} email={SITE.email} instagram={SITE.instagram}>
      <Badge tone="mint">{about.demoLabel}</Badge>
    </ContactBlock>
  </div>
</StoreLayout>

<style>
  @layer components {
    .hero,
    .awards {
      margin-inline: calc(var(--page-margin) * -1);
    }
    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-24);
      padding: var(--space-48) var(--page-margin) var(--space-64);
      background: var(--bg-inverse);
      color: var(--text-on-dark);
      text-align: center;
    }
    .hero__kicker {
      font-family: var(--font-ui);
      font-weight: var(--weight-bold);
      font-size: var(--text-caption);
      text-transform: uppercase;
    }
    h1 {
      max-inline-size: 28ch;
      font-family: var(--font-heading);
      font-weight: var(--weight-bold);
      font-size: var(--text-h2);
      line-height: var(--leading-h1);
      text-transform: uppercase;
      text-wrap: balance;
    }
    .hero__text {
      max-inline-size: 60ch;
      font-family: var(--font-editorial);
      font-size: var(--text-body-editorial);
      line-height: var(--leading-body-editorial);
      letter-spacing: var(--tracking-body-editorial);
    }
    .awards {
      display: grid;
    }
    .awards__list {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-24);
      padding: var(--space-48) var(--page-margin);
      background: var(--color-mint);
      color: var(--text-primary);
    }
    .awards__list :global(ul) {
      align-self: stretch;
    }
    h2 {
      font-family: var(--font-ui);
      font-weight: var(--weight-bold);
      font-size: var(--text-caption);
      text-transform: uppercase;
    }
    .awards__block {
      display: grid;
      place-items: center;
      min-height: 240px;
      background: var(--color-forest-mid);
      color: var(--text-on-dark);
      font-family: var(--font-brand);
      font-size: var(--text-h1);
      text-transform: uppercase;
    }
    @media (min-width: 800px) {
      .awards {
        grid-template-columns: 1fr 1fr;
      }
    }
  }
</style>
