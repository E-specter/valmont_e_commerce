# Plantilla de deploy/.env (T-100). No pongas valores reales aquí: deploy/.env no se versiona.
# Genera deploy/.env con secretos aleatorios: sh deploy/scripts/generate-env.sh

# --- Sitio ---
# Nombre que sirve Caddy: "localhost" en la prueba local; el dominio real en producción.
SITE_ADDRESS=localhost
# Interfaz donde se publican el 80 y el 443: 127.0.0.1 en local; 0.0.0.0 para abrirlo a la red.
BIND_ADDRESS=127.0.0.1
# URL pública del sitio: emisor de los tokens, enlaces de los correos y URLs de las imágenes.
PUBLIC_URL=https://localhost

# --- Secretos (vacíos aquí; los rellena generate-env.sh, en hexadecimal o base64url) ---
# Contraseña de Postgres: la de los roles internos de Supabase y la del propietario (migraciones).
POSTGRES_PASSWORD=
# Contraseña del rol valmont_app con el que se conecta el backend (scripts/migrate.sh la fija).
VALMONT_APP_DB_PASSWORD=
# Clave simétrica heredada de Auth y las claves de API HS256 firmadas con ella.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
# Par EC P-256 de Auth: JWT_KEYS (privada, firma los access tokens con ES256) y JWT_JWKS (pública).
JWT_KEYS=
JWT_JWKS=

# --- Correo (SMTP de Auth) ---
# Prueba local: Mailpit (docker compose --profile local), sin usuario ni contraseña.
# Producción: el servidor SMTP real, con su usuario y su contraseña.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_SENDER_NAME=Valmont
