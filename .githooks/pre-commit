#!/bin/sh
# Protocolo de control de versiones (docs/agents/PROTOCOL.md §11): ni .env ni secretos en el commit.
env_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..+)?$' | grep -v '\.env\.example$')
if [ -n "$env_files" ]; then
  echo "pre-commit: no se versionan archivos .env: $env_files" >&2
  exit 1
fi
added=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -v '^+++')
if printf '%s\n' "$added" | grep -iEq "(api[_-]?key|secret|password|token)[\"' ]*[:=] *[\"'][^\"']{8,}[\"']"; then
  echo "pre-commit: posible secreto literal en el cambio (clave/secreto/contraseña/token entre comillas)." >&2
  exit 1
fi
if printf '%s\n' "$added" | grep -Eq 'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.'; then
  echo "pre-commit: parece un JWT pegado en el cambio." >&2
  exit 1
fi
if git diff --cached -U0 -- '*.env.example' | grep -Eq '^\+[A-Z_]*(KEY|SECRET|PASSWORD|TOKEN)[A-Z_]*=.+'; then
  echo "pre-commit: .env.example no debe llevar valores secretos." >&2
  exit 1
fi
