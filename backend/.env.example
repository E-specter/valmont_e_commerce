ENVIRONMENT=dev
LOG_LEVEL=INFO
# Supabase local (npm run db:start). Contraseña por defecto de la CLI: solo desarrollo.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/valmont_test
# Copiar el valor de JWT_SECRET de `npx supabase status -o env`. Nunca versionar el valor real.
SUPABASE_JWT_SECRET=
