ENVIRONMENT=dev
LOG_LEVEL=INFO
# Supabase local (npm run db:start). Contraseña por defecto de la CLI: solo desarrollo.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/valmont_test
# Dónde el backend alcanza Supabase Auth; de su JWKS público salen las claves que verifican los tokens.
SUPABASE_URL=http://127.0.0.1:54321
# Emisor (iss) esperado en los tokens. Vacío = SUPABASE_URL + /auth/v1. Solo hace falta si el
# backend llega a Auth por una URL interna distinta de la pública (p. ej. la red de Docker).
# SUPABASE_JWT_ISSUER=
